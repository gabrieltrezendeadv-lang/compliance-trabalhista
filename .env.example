# =============================================================================
# Compliance Trabalhista — Variáveis de Ambiente
# =============================================================================
# Copie este arquivo para .env.local e preencha os valores.
# NUNCA commite .env.local no repositório.
# =============================================================================

# ─── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ─── E-mail — Resend (opcional em dev, obrigatório em prod) ──────────────────
# Docs: https://resend.com/docs/api-reference
RESEND_API_KEY=re_...
RESEND_FROM_ADDRESS=noreply@seudominio.com
RESEND_WEBHOOK_SECRET=whsec_...

# ─── WhatsApp — Meta Cloud API (opcional) ────────────────────────────────────
# Docs: https://developers.facebook.com/docs/whatsapp/cloud-api
WHATSAPP_ACCESS_TOKEN=EAA...
WHATSAPP_PHONE_NUMBER_ID=123456789
WHATSAPP_APP_SECRET=abc123...
WHATSAPP_VERIFY_TOKEN=token-aleatorio-que-voce-define

# ─── Billing ─────────────────────────────────────────────────────────────────
#
# A flag de produto NÃO é declarada aqui, de propósito: ausente é o estado
# desligado, e listá-la neste arquivo a faria parecer um botão a ser ligado.
# `tests/billing-orchestration-guard.mjs` (BO-12) reprova se ela aparecer.
#
# SELETOR DO PROVIDER — declara a INTENÇÃO, e é a única coisa que seleciona.
#
# Valores aceitos: mock | asaas. Ausente ou desconhecido REPROVA quando um
# provider é pedido; não existe padrão e não existe queda para lado nenhum.
#
# `mock` é recusado pelo construtor em NODE_ENV=production e em
# VERCEL_ENV=production. `asaas` exige a configuração abaixo COMPLETA — ter a
# chave sem este seletor não seleciona nada.
BILLING_PROVIDER=mock

# Configuração do Asaas. Docs: https://docs.asaas.com/reference
# Exigidas as três, e somente quando BILLING_PROVIDER=asaas.
ASAAS_API_KEY=$aact_...
ASAAS_ENVIRONMENT=sandbox
ASAAS_WEBHOOK_TOKEN=token-configurado-no-painel-asaas

# ─── App ─────────────────────────────────────────────────────────────────────
# URL pública da aplicação (usada em links de e-mail, webhooks, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Segredo server-only da rotina de encerramento de ciclos.
CRON_SECRET=
