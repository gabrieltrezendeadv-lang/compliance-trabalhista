# =============================================================================
# Compliance Trabalhista — Variáveis de Ambiente
# =============================================================================
# Copie este arquivo para .env.local e preencha os valores.
# NUNCA commite .env.local no repositório.
# =============================================================================

# ─── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ─── E-mail — Resend (opcional em dev, obrigatório em prod) ──────────────────
# Docs: https://resend.com/docs/api-reference
RESEND_API_KEY=re_...
RESEND_FROM_ADDRESS=noreply@seudominio.com
RESEND_WEBHOOK_SECRET=whsec_...

# ─── WhatsApp — Meta Cloud API (opcional) ────────────────────────────────────
# Docs: https://developers.facebook.com/docs/whatsapp/cloud-api
WHATSAPP_ACCESS_TOKEN=EAA...
WHATSAPP_PHONE_NUMBER_ID=123456789
WHATSAPP_APP_SECRET=abc123...
WHATSAPP_VERIFY_TOKEN=token-aleatorio-que-voce-define

# ─── Billing — Asaas (opcional em dev, obrigatório em prod) ──────────────────
# Docs: https://docs.asaas.com/reference
ASAAS_API_KEY=$aact_...
ASAAS_SANDBOX=true
ASAAS_WEBHOOK_TOKEN=token-configurado-no-painel-asaas

# Opt-ins exclusivos para desenvolvimento/teste. Nunca habilite em produção.
ALLOW_MOCK_BILLING_PROVIDER=false
ALLOW_INSECURE_BILLING_WEBHOOKS=false

# ─── App ─────────────────────────────────────────────────────────────────────
# URL pública da aplicação (usada em links de e-mail, webhooks, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000
